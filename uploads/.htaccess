# Logo images only. Do not run scripts from this folder.
Options -Indexes
RemoveHandler .php .phtml .phar .php5
<FilesMatch "\.(php|phtml|phar)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order Allow,Deny
        Deny from all
    </IfModule>
</FilesMatch>
